---
import Layout from "@/layouts/Layout.astro";
import { getApi } from "@/bknd.ts";

const api = await getApi(Astro, { verify: true, mode: "dynamic" });
const user = api.getUser();

if (!user) {
  return Astro.redirect("/login");
}

// Fetch existing cells for the user
const { data: cells } = await api.data.readMany("ax_cells", {
  where: { users: { id: user.id } },
  sort: { by: "order", dir: "asc" }
});
---

<Layout title="AX Experiment Playground">
  <div class="container mx-auto max-w-6xl px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="heading-1 mb-2 text-4xl">AX Experiment Playground</h1>
      <p class="text-muted-foreground">
        Interactive notebook for experimenting with LLM signatures and prompts
      </p>
    </div>

    <!-- Alpine.js State Container -->
    <div
      x-data="{
        cells: [],
        loading: false,
        error: null,

        init() {
          // Load initial cells from server
          this.loadCells();
        },

        async loadCells() {
          this.loading = true;
          try {
            const response = await fetch('/partials/ax-experiment/list');
            const html = await response.text();
            // Update the cells container
            this.$refs.cellsContainer.innerHTML = html;
          } catch (e) {
            this.error = e.message;
          } finally {
            this.loading = false;
          }
        },

        async addCell() {
          this.loading = true;
          this.error = null;
          try {
            const response = await fetch('/partials/ax-experiment/add', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
            });

            if (!response.ok) throw new Error('Failed to add cell');

            // Reload cells
            await this.loadCells();
          } catch (e) {
            this.error = e.message;
          } finally {
            this.loading = false;
          }
        },

        async deleteCell(cellId) {
          if (!confirm('Delete this cell?')) return;

          this.loading = true;
          this.error = null;
          try {
            const response = await fetch(`/partials/ax-experiment/${cellId}/delete`, {
              method: 'DELETE'
            });

            if (!response.ok) throw new Error('Failed to delete cell');

            // Reload cells
            await this.loadCells();
          } catch (e) {
            this.error = e.message;
          } finally {
            this.loading = false;
          }
        },

        async executeCell(cellId) {
          this.loading = true;
          this.error = null;
          try {
            const cellElement = document.querySelector(`[data-cell-id='${cellId}']`);
            const content = cellElement.querySelector('textarea').value;

            const response = await fetch(`/partials/ax-experiment/${cellId}/execute`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ content })
            });

            if (!response.ok) throw new Error('Failed to execute cell');

            const html = await response.text();
            cellElement.outerHTML = html;
          } catch (e) {
            this.error = e.message;
          } finally {
            this.loading = false;
          }
        }
      }"
    >
      <!-- Error Display -->
      <template x-if="error">
        <div class="alert mb-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" x2="12" y1="8" y2="12"></line>
            <line x1="12" x2="12.01" y1="16" y2="16"></line>
          </svg>
          <h2>Error</h2>
          <section x-text="error"></section>
        </div>
      </template>

      <!-- Toolbar -->
      <div class="mb-6 flex items-center justify-between">
        <div class="flex gap-2">
          <button @click="addCell()" class="btn" :disabled="loading">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="inline-block"
            >
              <path d="M5 12h14"></path>
              <path d="M12 5v14"></path>
            </svg>
            Add Cell
          </button>

          <button @click="loadCells()" class="btn-ghost" :disabled="loading">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="inline-block"
            >
              <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"></path>
            </svg>
            Refresh
          </button>
        </div>

        <div class="text-muted-foreground text-sm">
          <template x-if="loading">
            <span>Loading...</span>
          </template>
        </div>
      </div>

      <!-- Cells Container -->
      <div x-ref="cellsContainer" class="space-y-4">
        <!-- Initial cells from server -->
        {
          cells.length === 0 ? (
            <div class="card p-8 text-center">
              <p class="text-muted-foreground mb-4">No cells yet. Add your first cell to get started!</p>
              <button @click="addCell()" class="btn">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="inline-block"
                >
                  <path d="M5 12h14" />
                  <path d="M12 5v14" />
                </svg>
                Add First Cell
              </button>
            </div>
          ) : (
            cells.map((cell) => (
              <div class="card" data-cell-id={cell.id}>
                <div class="border-border bg-muted flex items-center justify-between border-b px-4 py-2">
                  <div class="text-muted-foreground flex items-center gap-2 text-sm">
                    <span class="badge">{cell.cell_type}</span>
                    <span>Cell {cell.order}</span>
                  </div>
                  <div class="flex gap-2">
                    <button @click={`executeCell(${cell.id})`} class="btn-ghost btn-sm">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polygon points="6 3 20 12 6 21 6 3" />
                      </svg>
                      Run
                    </button>
                    <button @click={`deleteCell(${cell.id})`} class="btn-ghost btn-sm text-destructive">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M3 6h18" />
                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                      </svg>
                      Delete
                    </button>
                  </div>
                </div>
                <div class="p-4">
                  <textarea
                    class="input mb-2 w-full font-mono text-sm"
                    rows="5"
                    placeholder="Enter your signature or code here..."
                  >{cell.content}</textarea>
                  {cell.output && (
                    <div class="bg-muted mt-4 rounded-md p-4">
                      <p class="text-muted-foreground mb-2 text-xs font-semibold uppercase">Output</p>
                      <pre class="text-foreground overflow-x-auto text-sm">{cell.output}</pre>
                    </div>
                  )}
                </div>
              </div>
            ))
          )
        }
      </div>
    </div>
  </div>
</Layout>
