---
import Layout from "../../layouts/Layout.astro";
import { getApi } from "@/bknd.ts";

const api = await getApi(Astro, { verify: true, mode: "dynamic" });
const user = api.getUser();

if (!user) {
  return Astro.redirect("/login");
}

// Get user's recipes
const { data: recipes } = await api.data.readMany("recipes", {
  filter: { userId: user.id }
});
---

<Layout title="My Recipes">
  <div
    class="container mx-auto max-w-7xl px-4 py-8"
    x-data="{
      importModalOpen: false,
      confirmDelete: false,
      deleteRecipeId: null,
      deleteRecipeName: '',
      loading: false,
      async toggleVisibility(recipeId) {
        this.loading = true;
        try {
          const response = await fetch(`/api/recipes/${recipeId}/toggle-visibility`, {
            method: 'PUT'
          });
          if (response.ok) {
            window.location.reload();
          }
        } catch (error) {
          console.error('Error toggling visibility:', error);
        } finally {
          this.loading = false;
        }
      },
      async deleteRecipe() {
        this.loading = true;
        try {
          const response = await fetch(`/api/recipes/${this.deleteRecipeId}`, {
            method: 'DELETE'
          });
          if (response.ok) {
            window.location.reload();
          }
        } catch (error) {
          console.error('Error deleting recipe:', error);
        } finally {
          this.loading = false;
        }
      },
      async importRecipe(formData) {
        this.loading = true;
        try {
          const response = await fetch('/api/recipes/import', {
            method: 'POST',
            body: formData
          });
          const result = await response.json();
          if (result.success) {
            window.location.reload();
          } else {
            alert(`Import failed: ${result.error}`);
          }
        } catch (error) {
          console.error('Error importing recipe:', error);
          alert('Failed to import recipe');
        } finally {
          this.loading = false;
        }
      }
    }"
  >
    <!-- Header -->
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="heading-1 mb-1 text-4xl">My Recipes</h1>
        <p class="text-muted-foreground">Manage and organize your recipe collection</p>
      </div>
      <div class="flex gap-3">
        <button @click="importModalOpen = true" class="btn-ghost inline-flex items-center gap-2" :disabled="loading">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" x2="12" y1="3" y2="15"></line>
          </svg>
          Import
        </button>
        <a href="/recipes/new" class="btn inline-flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14"></path>
            <path d="M12 5v14"></path>
          </svg>
          Create Recipe
        </a>
      </div>
    </div>

    <!-- Empty state -->
    {
      recipes.length === 0 ? (
        <div class="card">
          <div class="p-12 text-center">
            <div class="bg-muted mb-4 inline-flex h-16 w-16 items-center justify-center rounded-full">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-muted-foreground"
              >
                <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
                <path d="M7 2v20" />
                <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
              </svg>
            </div>
            <h2 class="heading-2 mb-2">No recipes yet</h2>
            <p class="text-muted-foreground mx-auto mb-6 max-w-md">
              Get started by creating your first recipe or importing from a YAML file.
            </p>
            <div class="flex justify-center gap-3">
              <button @click="importModalOpen = true" class="btn-ghost inline-flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="17 8 12 3 7 8" />
                  <line x1="12" x2="12" y1="3" y2="15" />
                </svg>
                Import Recipe
              </button>
              <a href="/recipes/new" class="btn inline-flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                  <path d="M12 5v14" />
                </svg>
                Create Recipe
              </a>
            </div>
          </div>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {recipes.map((recipe: any) => {
            const recipeId = recipe.id;
            const recipeName = recipe.name.replace(/'/g, "\\'");
            return (
              <div
                class="card group transition-shadow hover:shadow-lg"
                data-recipe-id={recipeId}
                data-recipe-name={recipe.name}
              >
                <div class="p-6">
                  <div class="mb-4">
                    <div class="mb-2 flex items-start justify-between gap-3">
                      <h2 class="heading-3 flex-1">
                        <a href={`/recipes/${recipeId}`} class="hover:underline">
                          {recipe.name}
                        </a>
                      </h2>
                      {recipe.public && (
                        <div class="badge badge-sm inline-flex items-center gap-1">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="10"
                            height="10"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                            <path d="M2 12h20" />
                          </svg>
                          Public
                        </div>
                      )}
                    </div>
                    {recipe.description && (
                      <p class="text-muted-foreground line-clamp-2 text-sm">{recipe.description}</p>
                    )}
                  </div>

                  <div class="text-muted-foreground mb-4 flex flex-wrap gap-4 text-sm">
                    <div class="flex items-center gap-1.5">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
                        <path d="M7 2v20" />
                        <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
                      </svg>
                      <span>{recipe.ingredients?.length || 0}</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <line x1="12" x2="12" y1="2" y2="6" />
                        <line x1="12" x2="12" y1="18" y2="22" />
                        <line x1="4.93" x2="7.76" y1="4.93" y2="7.76" />
                        <line x1="16.24" x2="19.07" y1="16.24" y2="19.07" />
                        <line x1="2" x2="6" y1="12" y2="12" />
                        <line x1="18" x2="22" y1="12" y2="12" />
                        <line x1="4.93" x2="7.76" y1="19.07" y2="16.24" />
                        <line x1="16.24" x2="19.07" y1="7.76" y2="4.93" />
                      </svg>
                      <span>{recipe.steps?.length || 0} steps</span>
                    </div>
                    {recipe.yields && recipe.yields.length > 0 && (
                      <div class="flex items-center gap-1.5">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <circle cx="9" cy="7" r="4" />
                          <path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" />
                        </svg>
                        <span>
                          {recipe.yields[0].amount} {recipe.yields[0].unit}
                        </span>
                      </div>
                    )}
                  </div>

                  <div class="flex gap-2 border-t pt-4">
                    <a
                      href={`/recipes/${recipeId}`}
                      class="btn-ghost inline-flex flex-1 items-center justify-center gap-2"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                        <circle cx="12" cy="12" r="3" />
                      </svg>
                      View
                    </a>
                    <div class="relative" x-data="{ open: false }" x-on:click.away="open = false">
                      <button
                        x-on:click="open = !open"
                        class="btn-ghost inline-flex h-9 w-9 items-center justify-center"
                        x-bind:disabled="loading"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <circle cx="12" cy="12" r="1" />
                          <circle cx="12" cy="5" r="1" />
                          <circle cx="12" cy="19" r="1" />
                        </svg>
                      </button>
                      <div
                        x-show="open"
                        x-transition
                        class="bg-background absolute right-0 z-10 mt-2 w-44 rounded-lg border shadow-lg"
                      >
                        <div class="py-1">
                          <button
                            x-on:click={`toggleVisibility('${recipeId}'); open = false`}
                            class="hover:bg-muted flex w-full items-center gap-2 px-4 py-2 text-left text-sm"
                          >
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                              <circle cx="12" cy="12" r="3" />
                            </svg>
                            {recipe.public ? "Make Private" : "Make Public"}
                          </button>
                          <a
                            href={`/api/recipes/${recipeId}/export`}
                            class="hover:bg-muted block flex items-center gap-2 px-4 py-2 text-sm"
                          >
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                              <polyline points="7 10 12 15 17 10" />
                              <line x1="12" x2="12" y1="15" y2="3" />
                            </svg>
                            Export YAML
                          </a>
                          <div class="my-1 border-t" />
                          <button
                            x-on:click={`deleteRecipeId = '${recipeId}'; deleteRecipeName = '${recipeName}'; confirmDelete = true; open = false`}
                            class="text-destructive hover:bg-muted flex w-full items-center gap-2 px-4 py-2 text-left text-sm"
                          >
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="M3 6h18" />
                              <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                              <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                            </svg>
                            Delete
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )
    }

    <!-- Import Modal -->
    <div
      x-show="importModalOpen"
      x-transition
      class="bg-background/80 fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm"
      @click.self="importModalOpen = false"
    >
      <div class="card mx-4 w-full max-w-md">
        <div class="p-6">
          <div class="mb-4 flex items-center justify-between">
            <h3 class="heading-3">Import Recipe</h3>
            <button
              @click="importModalOpen = false"
              class="btn-ghost inline-flex h-8 w-8 items-center justify-center rounded-full"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
              </svg>
            </button>
          </div>
          <p class="text-muted-foreground mb-4 text-sm">Upload a YAML file to import a recipe into your collection.</p>
          <form
            @submit.prevent="importRecipe(new FormData($event.target)); importModalOpen = false"
            enctype="multipart/form-data"
          >
            <div class="mb-4">
              <label class="mb-2 block text-sm font-medium"> Select YAML file </label>
              <input type="file" name="file" accept=".yaml,.yml" class="input w-full" required :disabled="loading" />
            </div>
            <div class="flex justify-end gap-3">
              <button type="button" @click="importModalOpen = false" class="btn-ghost" :disabled="loading">
                Cancel
              </button>
              <button type="submit" class="btn inline-flex items-center gap-2" :disabled="loading">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" x2="12" y1="3" y2="15"></line>
                </svg>
                <span x-show="!loading">Import</span>
                <span x-show="loading">Importing...</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Delete confirmation dialog -->
    <div
      x-show="confirmDelete"
      x-transition
      class="bg-background/80 fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm"
      @click.self="confirmDelete = false"
    >
      <div class="card mx-4 max-w-md">
        <div class="p-6">
          <h3 class="heading-3 mb-2">Delete Recipe</h3>
          <p class="text-muted-foreground mb-6">
            Are you sure you want to delete "<span class="font-medium" x-text="deleteRecipeName"></span>"? This action
            cannot be undone.
          </p>
          <div class="flex justify-end gap-3">
            <button @click="confirmDelete = false" class="btn-ghost" :disabled="loading"> Cancel </button>
            <button @click="deleteRecipe()" class="btn inline-flex items-center gap-2" :disabled="loading">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 6h18"></path>
                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
              </svg>
              <span x-show="!loading">Delete</span>
              <span x-show="loading">Deleting...</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
