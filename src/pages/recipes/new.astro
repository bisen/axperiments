---
import Layout from "../../layouts/Layout.astro";
import { getApi } from "@/bknd.ts";

const api = await getApi(Astro, { verify: true, mode: "dynamic" });
const user = api.getUser();

if (!user) {
  return Astro.redirect("/login");
}
---

<Layout title="Create New Recipe">
  <div
    class="container mx-auto max-w-5xl px-4 py-6"
    x-data="{
      loading: false,
      ingredients: [{ name: '', amount: '', unit: '' }],
      steps: [''],
      addIngredient() {
        this.ingredients.push({ name: '', amount: '', unit: '' });
      },
      removeIngredient(index) {
        this.ingredients.splice(index, 1);
      },
      addStep() {
        this.steps.push('');
      },
      removeStep(index) {
        this.steps.splice(index, 1);
      },
      async submitForm(event) {
        event.preventDefault();
        this.loading = true;

        const formData = new FormData(event.target);

        // Collect ingredients
        const ingredients = [];
        for (let i = 0; i < this.ingredients.length; i++) {
          const name = formData.get(`ingredient-name-${i}`);
          const amount = formData.get(`ingredient-amount-${i}`);
          const unit = formData.get(`ingredient-unit-${i}`);
          if (name && amount && unit) {
            ingredients.push({ name, amount, unit });
          }
        }

        // Collect steps
        const steps = [];
        for (let i = 0; i < this.steps.length; i++) {
          const step = formData.get(`step-${i}`);
          if (step && step.trim()) {
            steps.push(step.trim());
          }
        }

        // Build recipe data
        const recipeData = {
          name: formData.get('name'),
          description: formData.get('description'),
          public: formData.get('public') === 'on',
          ingredients,
          steps
        };

        // Add yields if provided
        const yieldAmount = formData.get('yieldAmount');
        const yieldUnit = formData.get('yieldUnit');
        if (yieldAmount) {
          recipeData.yields = [{
            amount: parseFloat(yieldAmount),
            unit: yieldUnit || 'servings'
          }];
        }

        // Add notes if provided
        const notes = formData.get('notes');
        if (notes && notes.trim()) {
          recipeData.notes = [notes.trim()];
        }

        // Add source if provided
        const sourceAuthor = formData.get('sourceAuthor');
        const sourceUrl = formData.get('sourceUrl');
        if (sourceAuthor || sourceUrl) {
          recipeData.source = {};
          if (sourceAuthor) recipeData.source.author = sourceAuthor;
          if (sourceUrl) recipeData.source.url = sourceUrl;
        }

        try {
          const response = await fetch('/api/recipes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(recipeData)
          });

          const result = await response.json();

          if (result.success && result.data) {
            window.location.href = `/recipes/${result.data.id}`;
          } else {
            alert(`Failed to create recipe: ${result.error || 'Unknown error'}`);
            this.loading = false;
          }
        } catch (error) {
          console.error('Error creating recipe:', error);
          alert('Failed to create recipe');
          this.loading = false;
        }
      }
    }"
  >
    <!-- Header -->
    <div class="mb-6 flex items-center justify-between">
      <a href="/recipes" class="btn-ghost inline-flex items-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Back to Recipes
      </a>
    </div>

    <div class="mb-6">
      <h1 class="heading-1 mb-2 text-4xl">Create New Recipe</h1>
      <p class="text-muted-foreground">Add a new recipe to your collection</p>
    </div>

    <form @submit="submitForm">
      <!-- Basic Info Card -->
      <div class="card mb-6">
        <div class="p-6">
          <h2 class="heading-2 mb-4">Basic Information</h2>

          <div class="space-y-4">
            <div>
              <label class="mb-2 block text-sm font-medium">Recipe Name *</label>
              <input
                type="text"
                name="name"
                class="input w-full"
                required
                maxlength="200"
                placeholder="My Delicious Recipe"
              />
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium">Description</label>
              <textarea
                name="description"
                class="input min-h-[80px] w-full"
                rows="3"
                placeholder="Describe your recipe..."></textarea>
            </div>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              <div>
                <label class="mb-2 block text-sm font-medium">Yield Amount</label>
                <input type="number" name="yieldAmount" class="input w-full" step="0.1" placeholder="8" />
              </div>
              <div>
                <label class="mb-2 block text-sm font-medium">Yield Unit</label>
                <input type="text" name="yieldUnit" class="input w-full" placeholder="servings" />
              </div>
            </div>

            <div class="flex items-center gap-2">
              <input type="checkbox" name="public" id="public-checkbox" class="border-input h-4 w-4 rounded" />
              <label for="public-checkbox" class="cursor-pointer text-sm select-none"> Make this recipe public </label>
            </div>
          </div>
        </div>
      </div>

      <!-- Ingredients Card -->
      <div class="card mb-6">
        <div class="p-6">
          <div class="mb-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary"
              >
                <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path>
                <path d="M7 2v20"></path>
                <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path>
              </svg>
              <h2 class="heading-2">Ingredients</h2>
            </div>
            <button
              type="button"
              class="btn inline-flex items-center gap-2"
              @click="addIngredient()"
              x-bind:disabled="loading"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14"></path>
                <path d="M12 5v14"></path>
              </svg>
              Add Ingredient
            </button>
          </div>

          <div class="space-y-3">
            <template x-for="(ingredient, index) in ingredients" x-bind:key="index">
              <div class="flex items-start gap-2">
                <input
                  type="text"
                  x-bind:name="`ingredient-name-${index}`"
                  x-model="ingredient.name"
                  placeholder="Ingredient name"
                  class="input flex-1"
                  required
                />
                <input
                  type="text"
                  x-bind:name="`ingredient-amount-${index}`"
                  x-model="ingredient.amount"
                  placeholder="2"
                  class="input w-20"
                  required
                />
                <input
                  type="text"
                  x-bind:name="`ingredient-unit-${index}`"
                  x-model="ingredient.unit"
                  placeholder="cups"
                  class="input w-24"
                  required
                />
                <button
                  type="button"
                  class="btn-ghost inline-flex h-9 w-9 items-center justify-center"
                  @click="removeIngredient(index)"
                  x-show="ingredients.length > 1"
                  x-bind:disabled="loading"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                  </svg>
                </button>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Steps Card -->
      <div class="card mb-6">
        <div class="p-6">
          <div class="mb-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary"
              >
                <line x1="12" x2="12" y1="2" y2="6"></line>
                <line x1="12" x2="12" y1="18" y2="22"></line>
                <line x1="4.93" x2="7.76" y1="4.93" y2="7.76"></line>
                <line x1="16.24" x2="19.07" y1="16.24" y2="19.07"></line>
                <line x1="2" x2="6" y1="12" y2="12"></line>
                <line x1="18" x2="22" y1="12" y2="12"></line>
                <line x1="4.93" x2="7.76" y1="19.07" y2="16.24"></line>
                <line x1="16.24" x2="19.07" y1="7.76" y2="4.93"></line>
              </svg>
              <h2 class="heading-2">Instructions</h2>
            </div>
            <button
              type="button"
              class="btn inline-flex items-center gap-2"
              @click="addStep()"
              x-bind:disabled="loading"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14"></path>
                <path d="M12 5v14"></path>
              </svg>
              Add Step
            </button>
          </div>

          <div class="space-y-4">
            <template x-for="(step, index) in steps" x-bind:key="index">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                  <div
                    class="bg-primary text-primary-foreground flex h-8 w-8 items-center justify-center rounded-full text-sm font-semibold"
                    x-text="index + 1"
                  >
                  </div>
                </div>
                <textarea
                  x-bind:name="`step-${index}`"
                  x-model="steps[index]"
                  placeholder="Describe this step..."
                  class="input min-h-[60px] flex-1"
                  rows="2"
                  required></textarea>
                <button
                  type="button"
                  class="btn-ghost inline-flex h-9 w-9 items-center justify-center"
                  @click="removeStep(index)"
                  x-show="steps.length > 1"
                  x-bind:disabled="loading"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                  </svg>
                </button>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Notes Card -->
      <div class="card mb-6">
        <div class="p-6">
          <div class="mb-4 flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="text-primary"
            >
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
              ></path>
            </svg>
            <h2 class="heading-2">Notes (Optional)</h2>
          </div>
          <textarea
            name="notes"
            class="input min-h-[80px] w-full"
            rows="3"
            placeholder="Add any additional notes, tips, or variations..."></textarea>
        </div>
      </div>

      <!-- Source Card -->
      <div class="card mb-6">
        <div class="p-6">
          <div class="mb-4 flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-primary"
            >
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
            </svg>
            <h2 class="heading-2">Source (Optional)</h2>
          </div>
          <div class="space-y-4">
            <div>
              <label class="mb-2 block text-sm font-medium">Author</label>
              <input type="text" name="sourceAuthor" class="input w-full" placeholder="Recipe author name" />
            </div>
            <div>
              <label class="mb-2 block text-sm font-medium">URL</label>
              <input type="url" name="sourceUrl" class="input w-full" placeholder="https://example.com/recipe" />
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="mt-8 flex justify-end gap-3">
        <a href="/recipes" class="btn-ghost inline-flex items-center gap-2" x-bind:disabled="loading"> Cancel </a>
        <button type="submit" class="btn inline-flex items-center gap-2" x-bind:disabled="loading">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
            <polyline points="17 21 17 13 7 13 7 21"></polyline>
            <polyline points="7 3 7 8 15 8"></polyline>
          </svg>
          <span x-show="!loading">Create Recipe</span>
          <span x-show="loading">Creating...</span>
        </button>
      </div>
    </form>
  </div>
</Layout>
