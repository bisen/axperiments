---
import { getApi } from "@/bknd.ts";
import CellsList from "@/components/CellsList.astro";

const api = await getApi(Astro);
const user = api.getUser();

if (!user) {
  return Astro.redirect("/login");
}

const { id } = Astro.params;

if (!id) {
  return new Response("Cell ID required", { status: 400 });
}

// Handle DELETE request
if (Astro.request.method === "DELETE") {
  try {
    // Verify ownership
    const { data: cell } = await api.data.readOne("ax_cells", id, {
      with: "users"
    });

    if (!cell) {
      return new Response("Cell not found", { status: 404 });
    }

    if (cell.users?.id !== user.id) {
      return new Response("Unauthorized", { status: 403 });
    }

    // Delete the cell
    await api.data.deleteOne("ax_cells", id);
  } catch (error) {
    Astro.response.status = 500;
    return new Response(
      `<div class="alert">
        <h2>Error</h2>
        <section>${error instanceof Error ? error.message : "Failed to delete cell"}</section>
      </div>`,
      { status: 500, headers: { "Content-Type": "text/html" } }
    );
  }
}

// Fetch remaining cells
const { data: cells } = await api.data.readMany("ax_cells", {
  where: { users: { id: user.id } },
  sort: { by: "order", dir: "asc" }
});

Astro.response.headers.set("Content-Type", "text/html");
---

<CellsList cells={cells} />
